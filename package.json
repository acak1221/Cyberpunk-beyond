{
  "name": "night-city-red",
  "version": "2.0.0",
  "private": true,
  "description": "Night City // RED — двуязычный офлайн-помощник для настольной игры Cyberpunk RED.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs site",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs dist --port 4173",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test \"tests/*.test.cjs\"",
    "e2e": "node tests/e2e/run.cjs"
  }
}
